{
  "name": "upnotice-server",
  "version": "4.0.0",
  "description": "UpNotice backend API - announcements, meetings, RSVP, notifications",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch-path=src src/index.js --dev",
    "seed": "node src/seed.js",
    "migrate:pg": "node src/migrate-to-postgres.js",
    "test": "node test/run-api.mjs",
    "test:unit": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "vitest": "^3.2.7"
  },
  "overrides": {
