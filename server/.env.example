# Copy this file to .env and change the values
PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
DB_FILE=./data/teamannounce.db
# Comma-separated list of allowed origins, or * for any (fine for local dev)
CORS_ORIGIN=*

# Optional: push notifications for the mobile apps (see README "Push notifications").
# Path to the Firebase service-account JSON you download from the Firebase console.
# FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
# Where uploaded attachments / photos are stored (default: next to the database)
# UPLOAD_DIR=./data/uploads
