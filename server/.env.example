# Copy this file to .env and change the values (npm run setup does the copy and fills in JWT_SECRET).

# ---- Database ----
# PostgreSQL (recommended). With Docker Desktop:  docker compose up -d db   (npm run dev does this for you)
DATABASE_URL=postgres://upnotice:upnotice@127.0.0.1:5433/upnotice
# Cloud PostgreSQL instead (Supabase, Neon, Railway…): paste its connection string, e.g. Supabase → Connect → "Session pooler":
# DATABASE_URL=postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Leave DATABASE_URL commented out to use a simple SQLite file instead (no database server needed):
# DB_FILE=./data/upnotice.db
#
# Cloud connections are encrypted AND the server's certificate is checked. Supabase's certificate authority ships with
# UpNotice (server/certs). For another provider download its CA file and point to it here:
# DATABASE_SSL_CA=./certs/my-provider-ca.crt
# DATABASE_SSL=no-verify   → encrypt but skip the certificate check (not recommended);  DATABASE_SSL=false → no encryption

# ---- Server ----
# Port for `npm start` / Docker (default 4000). Leave unset for `npm run dev`, which uses 4001 behind the Vite dev server.
# PORT=4000
# Signs the sign-in tokens. At least 32 random characters; `npm run setup` generates one. The server refuses to start
# in production without a real value. Changing it signs everyone out.
JWT_SECRET=change-this-to-a-long-random-string
# Public address of the app (used in email links, the password-reset link and as an allowed browser origin).
# APP_PUBLIC_URL=https://upnotice.yourcompany.com
# Extra browser origins allowed to call the API (comma-separated). The app served by this server, the desktop app and the
# mobile apps are always allowed; "*" allows any website (only for local experiments).
# CORS_ORIGIN=https://intranet.yourcompany.com
# Behind nginx / a load balancer: TRUST_PROXY=1 so rate limits and the activity log see the real client address.
# TRUST_PROXY=1
# LOG_LEVEL=info   (debug | info | warn | error)

# ---- First start ----
# Production creates ONE admin with a random password printed once in the log. Override with:
# ADMIN_EMAIL=you@yourcompany.com
# ADMIN_PASSWORD=choose-a-long-one
# SEED_DEMO=1 creates the demo companies and accounts instead (npm start sets this for you).

# ---- Email notifications (optional, see README "Email notifications") ----
# Without these the app still works; only the emails and "Forgot password?" are off.
# Option A – any SMTP mailbox (Gmail with an App Password, Outlook, your web host…):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# Option B – Resend (https://resend.com, free tier, no SMTP needed):
# RESEND_API_KEY=re_xxxxxxxx
# Sender shown to employees (Resend: must be a verified domain, or onboarding@resend.dev for testing)
# MAIL_FROM="UpNotice <no-reply@yourcompany.com>"

# Optional: push notifications for the mobile apps (see README "Push notifications").
# Path to the Firebase service-account JSON you download from the Firebase console.
# FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
# Where uploaded attachments / photos are stored (default: ./data/uploads)
# UPLOAD_DIR=./data/uploads
